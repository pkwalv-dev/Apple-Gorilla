  "auto_memory": true,
  "max_history_turns": 12,
  "max_memories": 200,
  "memory_embed_backend": "auto",
  "memory_embed_model": "nomic-embed-text",
  "memory_weights": {
    "semantic": 0.55,
    "keyword": 0.2,
    "recency": 0.15,
    "importance": 0.1
  },
  "memory_recency_halflife_days": 30.0,
  "memory_merge_threshold": 0.92,
  "memory_caps": {
    "episodic": 2000,
    "semantic": 1000,
    "procedural": 500
  },
  "memory_reflect": true,
  "memory_reflect_every": 10,
  "max_snapshots": 20,
  "max_runs": 100,
  "evolve_branch": "ag/evolve",
  "evolvable_paths": [
    "ag/prompts.py",
    "ag/tools/web.py",
    "ag/theme.py",
    "profile/principles.md",
    "config.json"
  ]
