{
  "backend": "ollama",
  "model": "claude-opus-5",
  "ollama_model": "qwen2.5:7b",
  "ollama_host": "http://127.0.0.1:11434",
  "ollama_keep_alive": "30m",
  "ollama_options": {
    "num_ctx": 8192,
    "num_gpu": 99
  },
  "effort": "high",
  "max_output_tokens": 32000,
  "meta_output_tokens": 16000,
  "max_iterations": 2,
  "critic_pass_threshold": 8.0,
  "speed_budget_s": 30.0,
  "score_weights": {
    "accuracy": 0.5,
    "quality": 0.3,
    "speed": 0.2
  },
  "autonomy_level": "guarded",
  "fitness_gate": true,
  "bench_mode": "optimize_execute",
  "bench_max_tasks": 0,
  "fitness_tol": 0.05,
  "allow_external_tools": false,
  "allow_web": true,
  "allow_local_tools": false,
  "max_tool_steps": 4,
  "use_memory": true,
  "max_memories": 200,
  "max_snapshots": 20,
  "max_runs": 100,
  "evolve_branch": "ag/evolve",
  "evolvable_paths": [
    "ag/prompts.py",
    "ag/tools/web.py",
    "ag/theme.py",
    "profile/principles.md",
    "config.json"
  ]
}
