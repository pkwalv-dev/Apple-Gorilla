{
  "_ag": {
    "title": "Wan 2.2 TI2V-5B \u2014 text to video",
    "model": "Wan-AI/Wan2.2-TI2V-5B (Apache-2.0)",
    "note": "Text-to-video and image-to-video in one checkpoint, and the largest open video model that fits an 8GB card (720p/5s with ComfyUI offloading). No filter in the weights. For image-to-video, add a LoadImage feeding Wan22ImageToVideoLatent.start_image. The 5B is published only at fp16 (9.3GB) \u2014 there is no fp8 of it; ComfyUI offloads what does not fit.",
    "files": {
      "models/diffusion_models/wan2.2_ti2v_5B_fp16.safetensors": "https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged (split_files/diffusion_models/)",
      "models/text_encoders/umt5_xxl_fp8_e4m3fn_scaled.safetensors": "https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged (split_files/text_encoders/)",
      "models/vae/wan2.2_vae.safetensors": "https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged (split_files/vae/)"
    }
  },
  "1": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan2.2_vae.safetensors"
    }
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__AG_PROMPT__",
      "clip": [
        "2",
        0
      ]
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "__AG_NEGATIVE__",
      "clip": [
        "2",
        0
      ]
    }
  },
  "6": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "width": "__AG_WIDTH__",
      "height": "__AG_HEIGHT__",
      "length": "__AG_FRAMES__",
      "batch_size": 1,
      "vae": [
        "3",
        0
      ]
    }
  },
  "7": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "shift": 8.0
    }
  },
  "8": {
    "class_type": "KSampler",
    "inputs": {
      "seed": "__AG_SEED__",
      "steps": "__AG_STEPS__",
      "cfg": 5.0,
      "sampler_name": "uni_pc",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": [
        "7",
        0
      ],
      "positive": [
        "4",
        0
      ],
      "negative": [
        "5",
        0
      ],
      "latent_image": [
        "6",
        0
      ]
    }
  },
  "9": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "8",
        0
      ],
      "vae": [
        "3",
        0
      ]
    }
  },
  "10": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "9",
        0
      ],
      "fps": "__AG_FPS__"
    }
  },
  "11": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "10",
        0
      ],
      "filename_prefix": "ag/wan",
      "format": "auto",
      "codec": "auto"
    }
  }
}
